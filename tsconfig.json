{
  "compilerOptions": {
    "moduleResolution": "bundler",
    "paths": {
      "@assets/*": [
        "./assets/*"
      ],
      "@components/*": [
        "./src/components/*"
      ],
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "react-native.config.js"
  ],
  "extends": "expo/tsconfig.base"
}
